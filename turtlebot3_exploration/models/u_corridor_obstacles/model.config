 <?xml version="1.0"?>

<model>
  <name>u_corridor_obstacles</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>

  <author>
    <name>Sayantan Datta</name>
    <email>sdatta3 at uncc dot edu</email>
